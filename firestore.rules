rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'credits',
          'planId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoUrl',
          'credits',
          'planId',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.credits is int
        && data.credits >= 0
        && data.credits <= 10000
        && data.planId in ['free', 'pro', 'live', 'max']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioCreation(data) {
      return data.keys().hasAll([
          'id',
          'userId',
          'mode',
          'title',
          'prompt',
          'model',
          'aspectRatio',
          'status',
          'creditsUsed',
          'mediaType',
          'outputUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'mode',
          'title',
          'prompt',
          'model',
          'aspectRatio',
          'status',
          'creditsUsed',
          'mediaType',
          'videoId',
          'outputUrl',
          'interactionId',
          'errorMessage',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.mode in ['text-to-video', 'image-to-video', 'mix', 'multi-editor', 'pinoc', 'live']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 1000
        && data.model is string
        && data.model.size() >= 1
        && data.model.size() <= 64
        && data.aspectRatio in ['16:9', '9:16']
        && data.status in ['queued', 'rendering', 'completed', 'failed']
        && data.creditsUsed is int
        && data.creditsUsed >= 0
        && data.creditsUsed <= 100
        && data.mediaType in ['video', 'image']
        && (!('videoId' in data) || (data.videoId is string && data.videoId.size() <= 128))
        && data.outputUrl is string
        && data.outputUrl.size() >= 1
        && data.outputUrl.size() <= 500
        && (!('interactionId' in data) || (data.interactionId is string && data.interactionId.size() <= 200))
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().credits == 80
        && incoming().planId == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().planId == existing().planId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'updatedAt']) &&
            incoming().credits >= 0 &&
            incoming().credits <= existing().credits
          )
        );

      allow delete: if false;

      match /creations/{creationId} {
        allow get: if isEmailVerified()
          && isValidId(userId)
          && isValidId(creationId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isEmailVerified()
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(creationId)
          && isOwner(userId)
          && isValidStudioCreation(incoming())
          && incoming().id == creationId
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.updatedAt == request.time;

        allow update: if isEmailVerified()
          && isValidId(userId)
          && isValidId(creationId)
          && isOwner(userId)
          && isValidStudioCreation(incoming())
          && !(existing().status in ['completed', 'failed'])
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().mode == existing().mode
          && incoming().aspectRatio == existing().aspectRatio
          && incoming().creditsUsed == existing().creditsUsed
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'outputUrl',
            'videoId',
            'interactionId',
            'errorMessage',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isEmailVerified()
          && isValidId(userId)
          && isValidId(creationId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
